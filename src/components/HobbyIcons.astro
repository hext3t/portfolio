---
import { desktopItems, projectBySlug, categoryById } from "../data/afterhours";

const folders = desktopItems.flatMap((i) => (i.type === "folder" ? [i] : []));
---

<section class="shelf">
  <ul class="folders" aria-describedby="shelf-hint">
    {desktopItems.map((item) => {
      if (item.type === "project") {
        const p = projectBySlug[item.slug];
        const c = categoryById[p.category];
        return (
          <li data-key={p.slug}>
            <button class="folder game" type="button" style={`--cat: ${c.color}`} data-open={p.slug} aria-haspopup="dialog">
              {p.icon ? (
                <img class="icon" src={p.icon} alt="" width="120" height="100" />
              ) : (
                <svg class="icon" viewBox="0 0 96 80" aria-hidden="true">
                  <rect x="12" y="2" width="72" height="72" rx="18" fill="currentColor" />
                  <path d="M42 24l22 14-22 14z" fill="#fff" />
                </svg>
              )}
              <span class="label">{p.title}</span>
            </button>
          </li>
        );
      }
      const c = categoryById[item.category];
      return (
        <li data-key={item.id}>
          <button
            class="folder"
            type="button"
            style={`--cat: ${c.color}`}
            aria-expanded="false"
            aria-controls={`tray-${item.id}`}
            data-tray
          >
            <svg class="icon icon-closed" viewBox="0 0 96 80" aria-hidden="true">
              <path d="M6 14a6 6 0 0 1 6-6h22l8 8h42a6 6 0 0 1 6 6v46a6 6 0 0 1-6 6H12a6 6 0 0 1-6-6z" fill="currentColor" opacity=".55" />
              <rect x="6" y="24" width="84" height="50" rx="6" fill="currentColor" />
            </svg>
            <svg class="icon icon-open" viewBox="0 0 96 80" aria-hidden="true">
              <path d="M6 14a6 6 0 0 1 6-6h22l8 8h42a6 6 0 0 1 6 6v46a6 6 0 0 1-6 6H12a6 6 0 0 1-6-6z" fill="currentColor" opacity=".55" />
              <path d="M16 30H94L82 74H6Z" fill="currentColor" stroke="currentColor" stroke-width="4" stroke-linejoin="round" />
            </svg>
            <span class="label">{item.label}</span>
          </button>
        </li>
      );
    })}
  </ul>

  {folders.map((f) => (
    <div class="tray" id={`tray-${f.id}`} hidden>
      <ul class="works">
        {f.projects.map((slug) => {
          const p = projectBySlug[slug];
          const c = categoryById[p.category];
          return (
            <li>
              <button type="button" class="work" data-open={p.slug} aria-haspopup="dialog">
                <span class="thumb" style={`--cat: ${c.color}`}>
                  {p.icon && <img src={p.icon} alt="" loading="lazy" />}
                </span>
                <span class="work-title">{p.title}</span>
              </button>
            </li>
          );
        })}
      </ul>
    </div>
  ))}

  <div class="shelf-tools">
    <button type="button" class="reset" id="shelf-reset" hidden>Reset icon order</button>
  </div>
  <p class="sr-only" id="shelf-hint">Press Shift with the arrow keys to rearrange the icons.</p>
  <p class="sr-only" id="shelf-live" aria-live="polite"></p>
</section>

<style>
  .shelf {
    position: relative;
    max-width: 1000px;
    margin-inline: auto;
    padding: var(--space-5) var(--page-pad);
  }

  .folders {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 640px) {
    .folders { grid-template-columns: repeat(2, 1fr); }
  }

  .folders > li { border-radius: 12px; }
  .folders > li[data-drop] { outline: 2px dashed var(--accent); outline-offset: 2px; }
  .folders > li.dragging {
    position: relative;
    z-index: 10;
    background: var(--surface);
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.25);
  }
  .folders.is-dragging, .folders.is-dragging .folder { cursor: grabbing; }

  .folder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-3);
    background: none;
    border: 0;
    border-radius: 12px;
    color: var(--cat, var(--accent));
    font: inherit;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }
  .folder:hover { background: color-mix(in srgb, var(--cat, var(--accent)) 8%, transparent); }
  .folder:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .icon { width: 120px; max-width: 100%; height: auto; }
  .icon-open { display: none; }
  .folder[aria-expanded="true"] .icon-closed { display: none; }
  .folder[aria-expanded="true"] .icon-open { display: block; }

  .label { color: var(--text); font-size: 0.95rem; }

  .tray {
    position: relative;
    margin-top: var(--space-4);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.12);
  }
  .tray[hidden] { display: none; }
  .tray:not([hidden]) {
    transform-origin: top;
    animation: pop 220ms cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }
  .tray::before {
    content: "";
    position: absolute;
    top: -9px;
    left: var(--caret-x, 50%);
    width: 16px;
    height: 16px;
    background: var(--surface);
    border-left: 1px solid var(--border);
    border-top: 1px solid var(--border);
    transform: translateX(-50%) rotate(45deg);
  }
  @keyframes pop {
    from { opacity: 0; transform: translateY(-8px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }

  .works {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .work {
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 8px;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .work:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .thumb {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    overflow: hidden;
    background: color-mix(in srgb, var(--cat, var(--accent)) 22%, var(--surface));
    border-bottom: 3px solid var(--cat, var(--accent));
    transition: transform 150ms ease;
  }
  .work:hover .thumb { transform: translateY(-2px); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .work-title { display: block; margin-top: var(--space-2); font-size: 0.85rem; color: var(--text-muted); }

  .shelf-tools { margin-top: var(--space-4); text-align: right; }
  .reset {
    min-height: 44px;
    padding: 0 var(--space-3);
    background: none;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .reset[hidden] { display: none; }
  .reset:hover { color: var(--text); }
  .reset:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  const shelf = document.querySelector<HTMLElement>(".shelf")!;
  const list = shelf.querySelector<HTMLElement>(".folders")!;
  const buttons = shelf.querySelectorAll<HTMLButtonElement>("[data-tray]");
  const trays = shelf.querySelectorAll<HTMLElement>(".tray");
  const resetBtn = document.getElementById("shelf-reset") as HTMLButtonElement;
  const live = document.getElementById("shelf-live")!;

  // ---------- Trays (same behaviour as the works page) ----------
  function trayFor(btn: HTMLButtonElement) {
    return document.getElementById(btn.getAttribute("aria-controls")!)!;
  }

  function placeCaret(btn: HTMLButtonElement, tray: HTMLElement) {
    const s = shelf.getBoundingClientRect();
    const b = btn.getBoundingClientRect();
    tray.style.setProperty("--caret-x", `${b.left - s.left + b.width / 2}px`);
  }

  function refreshCaret() {
    const active = shelf.querySelector<HTMLButtonElement>('[data-tray][aria-expanded="true"]');
    if (active) placeCaret(active, trayFor(active));
  }

  function closeAll() {
    buttons.forEach((b) => b.setAttribute("aria-expanded", "false"));
    trays.forEach((t) => (t.hidden = true));
  }

  function open(btn: HTMLButtonElement) {
    const tray = trayFor(btn);
    closeAll();
    btn.setAttribute("aria-expanded", "true");
    placeCaret(btn, tray);
    tray.hidden = false;
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      btn.getAttribute("aria-expanded") === "true" ? closeAll() : open(btn);
    });
  });

  window.addEventListener("resize", refreshCaret);

  // When a project opens (click or URL hash), expand the folder that holds it
  window.addEventListener("hobby:opened", (e) => {
    const folder = (e as CustomEvent<{ folder: string | null }>).detail.folder;
    if (!folder) return;
    const btn = shelf.querySelector<HTMLButtonElement>(`[data-tray][aria-controls="tray-${folder}"]`);
    if (btn && btn.getAttribute("aria-expanded") !== "true") open(btn);
  });

  // ---------- Icon order: saved per visitor ----------
  const STORAGE_KEY = "afterhours:order";

  function currentItems() {
    return Array.from(list.children) as HTMLElement[];
  }
  function currentKeys() {
    return currentItems().map((li) => li.dataset.key!);
  }
  const defaultKeys = currentKeys();

  function applyOrder(keys: string[]) {
    const byKey = new Map(currentItems().map((li) => [li.dataset.key!, li]));
    for (const k of keys) {
      const li = byKey.get(k);
      if (li) list.append(li);
    }
  }

  function save() {
    try {
      if (currentKeys().join() === defaultKeys.join()) localStorage.removeItem(STORAGE_KEY);
      else localStorage.setItem(STORAGE_KEY, JSON.stringify(currentKeys()));
    } catch {
      // storage can be blocked: the order just won't be remembered
    }
  }

  function load() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const saved = JSON.parse(raw);
      if (!Array.isArray(saved)) return;
      const known = saved.filter((k): k is string => typeof k === "string" && defaultKeys.includes(k));
      const ordered = [...new Set(known)];
      const rest = defaultKeys.filter((k) => !ordered.includes(k));
      applyOrder([...ordered, ...rest]);
    } catch {
      // ignore a broken saved value
    }
  }

  function updateReset() {
    resetBtn.hidden = currentKeys().join() === defaultKeys.join();
  }

  function afterReorder(li: HTMLElement) {
    save();
    updateReset();
    refreshCaret();
    const items = currentItems();
    const label = li.querySelector(".label")?.textContent ?? "Icon";
    live.textContent = `${label} moved to position ${items.indexOf(li) + 1} of ${items.length}`;
  }

  resetBtn.addEventListener("click", () => {
    applyOrder(defaultKeys);
    save();
    updateReset();
    refreshCaret();
    live.textContent = "Icon order reset";
  });

  load();
  updateReset();

  // ---------- Keyboard: Shift + arrow keys move the focused icon ----------
  list.addEventListener("keydown", (e) => {
    if (!e.shiftKey || e.altKey || e.ctrlKey || e.metaKey) return;
    const dir =
      e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 :
      e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : 0;
    if (!dir) return;
    const btn = (e.target as Element).closest<HTMLButtonElement>(".folder");
    if (!btn) return;
    e.preventDefault();
    const li = btn.closest("li") as HTMLElement;
    const items = currentItems();
    const to = items.indexOf(li) + dir;
    if (to < 0 || to >= items.length) return;
    if (dir > 0) items[to].after(li);
    else items[to].before(li);
    btn.focus();
    afterReorder(li);
  });

  // ---------- Mouse and pen: drag to reorder (touch is left alone so scrolling works) ----------
  interface DragState {
    li: HTMLElement;
    btn: HTMLButtonElement;
    pointerId: number;
    startX: number;
    startY: number;
    active: boolean;
    target: HTMLElement | null;
  }
  let drag: DragState | null = null;
  let suppressClick = false;
  const THRESHOLD = 6;

  shelf.addEventListener("dragstart", (e) => e.preventDefault());

  list.addEventListener("pointerdown", (e) => {
    if (e.pointerType === "touch" || e.button !== 0) return;
    const btn = (e.target as Element).closest<HTMLButtonElement>(".folder");
    if (!btn) return;
    drag = {
      li: btn.closest("li") as HTMLElement,
      btn,
      pointerId: e.pointerId,
      startX: e.clientX,
      startY: e.clientY,
      active: false,
      target: null,
    };
  });

  window.addEventListener("pointermove", (e) => {
    const d = drag;
    if (!d || e.pointerId !== d.pointerId) return;
    const mx = e.clientX - d.startX;
    const my = e.clientY - d.startY;

    if (!d.active) {
      if (Math.hypot(mx, my) < THRESHOLD) return;
      d.active = true;
      d.btn.setPointerCapture(d.pointerId);
      d.li.classList.add("dragging");
      list.classList.add("is-dragging");
    }

    d.li.style.transform = `translate(${mx}px, ${my}px) scale(1.04)`;

    let target: HTMLElement | null = null;
    for (const other of currentItems()) {
      if (other === d.li) continue;
      const r = other.getBoundingClientRect();
      if (e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom) {
        target = other;
        break;
      }
    }
    if (target !== d.target) {
      d.target?.removeAttribute("data-drop");
      target?.setAttribute("data-drop", "");
      d.target = target;
    }
  });

  function endDrag(commit: boolean) {
    const d = drag;
    drag = null;
    if (!d || !d.active) return;

    // The click that follows a drag must not open anything
    suppressClick = true;
    setTimeout(() => { suppressClick = false; }, 0);

    d.li.classList.remove("dragging");
    d.li.style.transform = "";
    list.classList.remove("is-dragging");
    d.target?.removeAttribute("data-drop");

    if (commit && d.target) {
      const items = currentItems();
      if (items.indexOf(d.target) > items.indexOf(d.li)) d.target.after(d.li);
      else d.target.before(d.li);
      afterReorder(d.li);
    }
  }

  window.addEventListener("pointerup", () => endDrag(true));
  window.addEventListener("pointercancel", () => endDrag(false));

  shelf.addEventListener(
    "click",
    (e) => {
      if (suppressClick) {
        e.stopPropagation();
        e.preventDefault();
      }
    },
    true
  );

  // Esc cancels a drag in progress, otherwise closes any open tray
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (drag?.active) {
      endDrag(false);
      return;
    }
    if (!document.querySelector("dialog[open]")) closeAll();
  });
</script>