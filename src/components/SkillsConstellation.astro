---
// src/components/SkillsConstellation.astro
// Uses src/data/skills.ts. The layout is computed once at build time (deterministic), so the graph never jitters.
import { categories, skills, skillsByCategory } from '../data/skills';
import type { CategoryId } from '../data/skills';

const W = 1000;
const H = 680;

// Hub (category) positions. Categories that share skills sit close together.
const centers: Record<CategoryId, { x: number; y: number }> = {
  design: { x: 400, y: 350 },
  photo: { x: 150, y: 230 },
  video: { x: 520, y: 130 },
  uiux: { x: 800, y: 340 },
  afterhours: { x: 610, y: 560 },
};

// Small seeded random generator so the layout is identical on every build
function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(7);

interface N {
  id: string;
  label: string;
  cats: CategoryId[];
  x: number;
  y: number;
  minor: boolean;
}
const nodes: N[] = [];

for (const c of categories) {
  // Skills that belong only to this category sit on a loose ring around its hub
  const own = skills.filter((s) => s.categories.length === 1 && s.categories[0] === c.id);
  const base = rand() * Math.PI * 2;
  own.forEach((s, i) => {
    const a = base + (i / own.length) * Math.PI * 2 + (rand() - 0.5) * 0.4;
    const rad = 60 + own.length * 9 + rand() * 30;
    nodes.push({
      id: s.id,
      label: s.label,
      cats: s.categories,
      x: centers[c.id].x + Math.cos(a) * rad,
      y: centers[c.id].y + Math.sin(a) * rad,
      minor: !!s.minor,
    });
  });
}
// Shared skills sit between their categories
for (const s of skills.filter((s) => s.categories.length > 1)) {
  const pts = s.categories.map((c) => centers[c]);
  nodes.push({
    id: s.id,
    label: s.label,
    cats: s.categories,
    x: pts.reduce((a, p) => a + p.x, 0) / pts.length + (rand() - 0.5) * 30,
    y: pts.reduce((a, p) => a + p.y, 0) / pts.length + (rand() - 0.5) * 30,
    minor: !!s.minor,
  });
}

// Relax overlaps. Labels are wide, so horizontal distance counts for less.
const SX = 0.55;
for (let it = 0; it < 120; it++) {
  for (let i = 0; i < nodes.length; i++) {
    const a = nodes[i];
    for (let j = i + 1; j < nodes.length; j++) {
      const b = nodes[j];
      const dx = (b.x - a.x) * SX;
      const dy = b.y - a.y;
      const d = Math.hypot(dx, dy) || 0.01;
      if (d < 46) {
        const push = (46 - d) / 2;
        a.x -= ((dx / d) * push) / SX;
        a.y -= (dy / d) * push;
        b.x += ((dx / d) * push) / SX;
        b.y += (dy / d) * push;
      }
    }
    for (const h of Object.values(centers)) {
      const dx = a.x - h.x;
      const dy = a.y - h.y;
      const d = Math.hypot(dx, dy) || 0.01;
      if (d < 60) {
        a.x += (dx / d) * (60 - d);
        a.y += (dy / d) * (60 - d);
      }
    }
    a.x = Math.min(W - 70, Math.max(70, a.x));
    a.y = Math.min(H - 40, Math.max(40, a.y));
  }
}

// Constellation "figure" lines: join each category's stars in angular order
const chains = categories.flatMap((c) => {
  const h = centers[c.id];
  const members = nodes
    .filter((n) => n.cats.includes(c.id))
    .sort((p, q) => Math.atan2(p.y - h.y, p.x - h.x) - Math.atan2(q.y - h.y, q.x - h.x));
  return members.slice(1).map((m, i) => ({ cat: c.id, a: members[i], b: m }));
});

// Decorative background stars
const bgRand = rng(21);
const bgStars = Array.from({ length: 70 }, () => ({
  x: bgRand() * W,
  y: bgRand() * H,
  r: 0.5 + bgRand() * 0.9,
  o: 0.2 + bgRand() * 0.5,
  d: bgRand() * 6,
}));

const names = Object.fromEntries(categories.map((c) => [c.id, c.label]));
const star = (s: number) => `M0,${-s} Q0,0 ${s},0 Q0,0 0,${s} Q0,0 ${-s},0 Q0,0 0,${-s} Z`;
---

<section class="constellation" aria-labelledby="skills-heading" data-names={JSON.stringify(names)}>
  <h2 id="skills-heading" class="sr-only">Skills</h2>

  <div class="stage" data-stage>
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" role="group" aria-label="Skills constellation. Select a star to highlight its category.">
      <g class="bg" data-bg>
        {bgStars.map((s) => (
          <circle class="bgstar" cx={s.x} cy={s.y} r={s.r} style={`opacity:${s.o};animation-delay:${s.d}s`} />
        ))}
      </g>

      <g class="graph" data-graph>
        <g class="lines">
          {chains.map((l) => (
            <line class="chain" data-cats={l.cat} x1={l.a.x} y1={l.a.y} x2={l.b.x} y2={l.b.y} style={`--c:var(--c-${l.cat})`} />
          ))}
          {nodes.flatMap((n) =>
            n.cats.map((c) => (
              <line class="spoke" data-cats={c} x1={n.x} y1={n.y} x2={centers[c].x} y2={centers[c].y} style={`--c:var(--c-${c})`} />
            ))
          )}
        </g>

        <g class="stars">
          {categories.map((c) => (
            <g
              class="star hub"
              data-cats={c.id}
              role="button"
              tabindex="0"
              aria-pressed="false"
              aria-label={`${c.label} category`}
              transform={`translate(${centers[c.id].x} ${centers[c.id].y})`}
              style={`--c:var(--c-${c.id})`}
            >
              <circle class="hit" r="22" />
              <circle class="halo" r="16" />
              <path class="core" d={star(13)} />
              <text class="name" y="34" text-anchor="middle">{c.label}</text>
            </g>
          ))}

          {nodes.map((n, i) => (
            <g
              class={`star skill${n.cats.length > 1 ? ' shared' : ''}${n.minor ? ' minor' : ''}`}
              data-cats={n.cats.join(' ')}
              role="button"
              tabindex="0"
              aria-pressed="false"
              aria-label={`${n.label}, ${n.cats.map((c) => names[c]).join(' and ')}`}
              transform={`translate(${n.x} ${n.y})`}
              style={`--c:var(--c-${n.cats[0]});--c2:var(--c-${n.cats[1] ?? n.cats[0]});--d:${(i % 7) * 0.8}s`}
            >
              <circle class="hit" r="16" />
              <circle class="halo" r={n.minor ? 7 : 9} />
              {n.cats.length > 1 && <circle class="ring" r="8" />}
              <circle class="core" r={n.minor ? 3 : 4.5} />
              <text y="22" text-anchor="middle">{n.label}</text>
            </g>
          ))}
        </g>
      </g>
    </svg>
  </div>

  <p class="status" aria-live="polite" data-status>Select a star to highlight its category.</p>

  <!-- Shown instead of the graph on narrow screens -->
  <div class="fallback">
    {skillsByCategory.map(({ category, skills }) => (
      <section style={`--c:var(--c-${category.id})`}>
        <h3>{category.label}</h3>
        <ul>{skills.map((s) => <li>{s.label}</li>)}</ul>
      </section>
    ))}
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.constellation');

  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const graph = root.querySelector<SVGGElement>('[data-graph]')!;
    const bg = root.querySelector<SVGGElement>('[data-bg]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const names = JSON.parse(root.dataset.names ?? '{}') as Record<string, string>;
    const items = root.querySelectorAll<SVGElement>('[data-cats]');
    const defaultText = status.textContent ?? '';

    let pressed: Element | null = null;

    const clear = () => {
      pressed = null;
      root.classList.remove('has-selection');
      items.forEach((el) => {
        el.classList.remove('active');
        if (el.getAttribute('role') === 'button') el.setAttribute('aria-pressed', 'false');
      });
      status.textContent = defaultText;
    };

    const select = (target: SVGElement) => {
      const cats = (target.dataset.cats ?? '').split(' ');
      pressed = target;
      root.classList.add('has-selection');
      let count = 0;
      items.forEach((el) => {
        const on = (el.dataset.cats ?? '').split(' ').some((c) => cats.includes(c));
        el.classList.toggle('active', on);
        if (el.getAttribute('role') === 'button') {
          el.setAttribute('aria-pressed', String(el === target));
          if (on && el.classList.contains('skill')) count++;
        }
      });
      status.textContent = `${cats.map((c) => names[c]).join(' & ')} · ${count} skills. Click the background or press Esc to clear.`;
    };

    const toggle = (target: SVGElement) => (pressed === target ? clear() : select(target));

    stage.addEventListener('click', (e) => {
      const target = (e.target as Element).closest<SVGElement>('[role="button"]');
      target ? toggle(target) : clear();
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') return clear();
      const target = (e.target as Element).closest<SVGElement>('[role="button"]');
      if (target && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        toggle(target);
      }
    });

    // Gentle parallax: the whole sky drifts toward the pointer, background stars drift less
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;

      const step = () => {
        raf = 0;
        cx += (tx - cx) * 0.08;
        cy += (ty - cy) * 0.08;
        graph.style.transform = `translate(${cx * -10}px, ${cy * -8}px) rotate(${cx * 0.6}deg)`;
        bg.style.transform = `translate(${cx * -4}px, ${cy * -3}px)`;
        if (Math.abs(tx - cx) > 0.002 || Math.abs(ty - cy) > 0.002) raf = requestAnimationFrame(step);
      };
      const run = () => { if (!raf) raf = requestAnimationFrame(step); };

      stage.addEventListener('pointermove', (e) => {
        const r = stage.getBoundingClientRect();
        tx = ((e.clientX - r.left) / r.width - 0.5) * 2;
        ty = ((e.clientY - r.top) / r.height - 0.5) * 2;
        run();
      });
      stage.addEventListener('pointerleave', () => { tx = 0; ty = 0; run(); });
    }
  }
</script>

<style>
  .constellation {
    /* Placeholder palette: swap for your design tokens */
    --c-design: #ff9f80;
    --c-photo: #ffd36e;
    --c-video: #8db6ff;
    --c-uiux: #6fe3c1;
    --c-afterhours: #c9a0ff;
    --sky: #0b1020;
    --ink: #e8ecff;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .stage {
    background: radial-gradient(ellipse at 50% 40%, #151c3a 0%, var(--sky) 70%);
    border-radius: 1rem;
    overflow: hidden;
  }
  svg { display: block; width: 100%; height: auto; }

  .graph, .bg {
    transform-box: view-box;
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .bgstar { fill: #fff; animation: twinkle 5s ease-in-out infinite; }

  /* Lines */
  .spoke { stroke: var(--c); stroke-width: 0.8; opacity: 0.28; transition: opacity 0.3s; }
  .chain { stroke: var(--c); stroke-width: 0.8; opacity: 0.16; stroke-dasharray: 2 5; transition: opacity 0.3s; }

  /* Stars */
  .star { cursor: pointer; outline: none; transition: opacity 0.3s; }
  .star .hit { fill: transparent; }
  .star .halo {
    fill: var(--c);
    opacity: 0.16;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.3s, opacity 0.3s;
  }
  .star .core { fill: var(--c); animation: twinkle 4s ease-in-out infinite; animation-delay: var(--d, 0s); }
  .star .ring { fill: none; stroke: var(--c2); stroke-width: 1.4; opacity: 0.9; }
  .star text {
    fill: var(--ink);
    font-size: 12px;
    opacity: 0.7;
    paint-order: stroke;
    stroke: var(--sky);
    stroke-width: 3px;
    stroke-linejoin: round;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .star.hub text { font-size: 15px; font-weight: 600; opacity: 0.85; }

  .star:hover .halo,
  .star:focus-visible .halo { transform: scale(2.4); opacity: 0.35; }
  .star:hover text,
  .star:focus-visible text { opacity: 1; }
  .star:focus-visible .core { stroke: #fff; stroke-width: 1.5; }

  /* Selection: everything fades except the chosen category */
  .has-selection .star:not(.active),
  .has-selection .spoke:not(.active),
  .has-selection .chain:not(.active) { opacity: 0.12; }
  .has-selection .spoke.active { opacity: 0.7; }
  .has-selection .chain.active { opacity: 0.45; }
  .has-selection .star.active .halo { opacity: 0.35; }
  .has-selection .star.active text { opacity: 1; }
  .has-selection .star.hub.active text { font-size: 18px; }

  .status { margin: 0.75rem 0 0; font-size: 0.9rem; opacity: 0.8; text-align: center; min-height: 1.4em; }

  @keyframes twinkle { 50% { opacity: 0.45; } }
  @media (prefers-reduced-motion: reduce) {
    .bgstar, .star .core { animation: none; }
    .star, .star .halo, .spoke, .chain, .star text { transition: none; }
  }

  /* Narrow screens: skip the graph, show a plain grouped list */
  .fallback { display: none; }
  @media (max-width: 640px) {
    .stage, .status { display: none; }
    .fallback { display: grid; gap: 1.25rem; }
    .fallback h3 { margin: 0 0 0.4rem; color: var(--c); font-size: 1rem; }
    .fallback ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .fallback li { padding: 0.2rem 0.65rem; border: 1px solid var(--c); border-radius: 999px; font-size: 0.85rem; }
  }
</style>