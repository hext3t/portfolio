---
import { categories, works } from "../data/works";

const catById = Object.fromEntries(categories.map((c) => [c.id, c]));
---

<dialog class="window" id="work-window" aria-labelledby="window-title">
  <div class="win">
    <div class="titlebar" data-drag-handle>
      <div class="lights">
        <button type="button" class="light close" aria-label="Close window" data-close></button>
        <span class="light min" aria-hidden="true"></span>
        <span class="light max" aria-hidden="true"></span>
      </div>
      <h2 id="window-title" class="win-title">Project</h2>
      <button type="button" class="done" data-close>Done</button>
    </div>
    <div class="content" id="window-content"></div>
  </div>
</dialog>

{works.map((w) => {
  const c = catById[w.category];
  return (
    <template id={`work-${w.slug}`} data-title={w.title} data-category={w.category}>
      <article class="project" style={`--cat: ${c.color}`}>
        <div class="meta">
          <span class="pill"><span class="dot"></span>{c.label}</span>
          <span class="date">{w.date}</span>
        </div>
        <p class="desc">{w.description}</p>
        {w.tools.length > 0 && (
          <ul class="tools" aria-label="Tools used">
            {w.tools.map((t) => <li>{t}</li>)}
          </ul>
        )}
        <div class="media">
          {w.media.length === 0 && <div class="placeholder">Media coming soon</div>}
          {w.media.map((m) =>
            m.type === "image" ? (
              <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
            ) : (
              <div class="video">
                <iframe
                  src={m.type === "youtube"
                    ? `https://www.youtube-nocookie.com/embed/${m.id}`
                    : `https://player.vimeo.com/video/${m.id}`}
                  title={m.title}
                  loading="lazy"
                  allow="fullscreen; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            )
          )}
        </div>
        {/* Later: <a class="fullpage" href={`/works/${w.slug}`}>Open full page</a> */}
      </article>
    </template>
  );
})}

<style>
  .window {
    width: min(760px, calc(100vw - 2rem));
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
    overflow: hidden;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.35);
    transform: translate(var(--dx, 0px), var(--dy, 0px));
  }
  .window::backdrop { background: rgb(0 0 0 / 0.25); }
  .window[open] { animation: win-in 200ms cubic-bezier(0.2, 0.9, 0.3, 1.1); }
  @keyframes win-in {
    from { opacity: 0; scale: 0.96; }
    to { opacity: 1; scale: 1; }
  }

  .win {
    display: flex;
    flex-direction: column;
    max-height: min(80vh, 760px);
  }

  .titlebar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0.6rem 0.9rem;
    background: color-mix(in srgb, var(--text) 5%, var(--surface));
    border-bottom: 1px solid var(--border);
    user-select: none;
  }
  .lights { display: flex; gap: 8px; }
  .light {
    position: relative;
    width: 12px;
    height: 12px;
    padding: 0;
    border: 0;
    border-radius: 50%;
  }
  .close { background: #ff5f57; cursor: pointer; }
  .min { background: #febc2e; }
  .max { background: #28c840; }
  .close::after { content: ""; position: absolute; inset: -8px; } /* bigger hit area */
  .close:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .win-title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 40ch;
  }
  .done {
    display: none;
    justify-self: end;
    min-height: 44px;
    padding: 0 var(--space-2);
    background: none;
    border: 0;
    color: var(--accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .content { overflow: auto; min-height: 0; padding: var(--space-4); }

  .meta { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    font-size: 0.8rem;
    background: color-mix(in srgb, var(--cat) 18%, var(--surface));
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--cat); }
  .date { font-size: 0.85rem; color: var(--text-muted); }
  .desc { margin: var(--space-3) 0; }

  .tools { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; margin: 0 0 var(--space-4); padding: 0; }
  .tools li {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .media { display: grid; gap: var(--space-3); }
  .media img { width: 100%; height: auto; border-radius: 8px; display: block; }
  .video { aspect-ratio: 16 / 9; border-radius: 8px; overflow: hidden; background: #000; }
  .video iframe { width: 100%; height: 100%; border: 0; }
  .placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--cat) 15%, var(--surface));
  }

  /* Desktop: draggable title bar */
  @media (min-width: 721px) {
    .titlebar { cursor: grab; touch-action: none; }
    .titlebar:active { cursor: grabbing; }
  }

  /* Mobile: full-height sheet sliding up from the bottom */
  @media (max-width: 720px) {
    .window {
      width: 100%;
      max-width: 100%;
      height: calc(100dvh - 2rem);
      max-height: none;
      margin: auto 0 0 0;
      border-width: 1px 0 0;
      border-radius: 16px 16px 0 0;
      transform: none;
    }
    .window[open] { animation: sheet-in 260ms cubic-bezier(0.2, 0.9, 0.3, 1); }
    @keyframes sheet-in {
      from { translate: 0 100%; }
      to { translate: 0 0; }
    }
    .win { height: 100%; max-height: none; }
    .done { display: block; }
    .close::after { inset: -16px; }
    .content { padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px)); }
  }
</style>

<script>
  const dialog = document.getElementById("work-window") as HTMLDialogElement;
  const content = document.getElementById("window-content")!;
  const titleEl = document.getElementById("window-title")!;
  const titlebar = dialog.querySelector<HTMLElement>("[data-drag-handle]")!;
  const desktop = window.matchMedia("(min-width: 721px)");

  let currentSlug: string | null = null;
  let openedByPush = false;
  let dx = 0;
  let dy = 0;

  function applyOffset() {
    dialog.style.setProperty("--dx", `${dx}px`);
    dialog.style.setProperty("--dy", `${dy}px`);
  }

  function openWork(slug: string, push: boolean) {
    if (slug === currentSlug && dialog.open) return;
    const tpl = document.getElementById(`work-${slug}`) as HTMLTemplateElement | null;
    if (!tpl) return;

    content.replaceChildren(tpl.content.cloneNode(true));
    content.scrollTop = 0;
    titleEl.textContent = tpl.dataset.title ?? "";
    currentSlug = slug;
    dx = 0;
    dy = 0;
    applyOffset();

    if (!dialog.open) dialog.showModal();

    if (push && location.hash !== `#${slug}`) {
      history.pushState(null, "", `#${slug}`);
      openedByPush = true;
    }

    window.dispatchEvent(
      new CustomEvent("work:opened", { detail: { category: tpl.dataset.category } })
    );
  }

  // Runs for every way of closing: red dot, Done, Esc, backdrop, back button
  dialog.addEventListener("close", () => {
    content.replaceChildren(); // also stops any playing video
    currentSlug = null;
    const pushed = openedByPush;
    openedByPush = false;
    if (location.hash) {
      if (pushed) history.back();
      else history.replaceState(null, "", location.pathname + location.search);
    }
  });

  // Open/close from the URL hash (links, refresh, back/forward)
  function syncFromHash() {
    const slug = decodeURIComponent(location.hash.slice(1));
    if (/^[a-z0-9-]+$/.test(slug) && document.getElementById(`work-${slug}`)) {
      openWork(slug, false);
    } else if (dialog.open) {
      openedByPush = false;
      dialog.close();
    }
  }
  window.addEventListener("popstate", syncFromHash);
  window.addEventListener("hashchange", syncFromHash);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", syncFromHash);
  } else {
    syncFromHash();
  }

  // Clicks: open a work, close buttons, backdrop
  let downOnBackdrop = false;
  dialog.addEventListener("pointerdown", (e) => {
    downOnBackdrop = e.target === dialog;
  });
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const workBtn = target.closest<HTMLElement>("[data-work]");
    if (workBtn) {
      openWork(workBtn.dataset.work!, true);
      return;
    }
    if (target.closest("[data-close]") || (target === dialog && downOnBackdrop)) {
      dialog.close();
    }
  });

  // Desktop dragging by the title bar
  let drag: { startX: number; startY: number } | null = null;

  function clampToViewport() {
    const r = dialog.getBoundingClientRect();
    const margin = 80;
    if (r.top < 0) dy -= r.top;
    if (r.top > innerHeight - 48) dy -= r.top - (innerHeight - 48);
    if (r.right < margin) dx += margin - r.right;
    if (r.left > innerWidth - margin) dx -= r.left - (innerWidth - margin);
    applyOffset();
  }

  titlebar.addEventListener("pointerdown", (e) => {
    if (!desktop.matches || (e.target as HTMLElement).closest("button")) return;
    drag = { startX: e.clientX - dx, startY: e.clientY - dy };
    titlebar.setPointerCapture(e.pointerId);
  });
  titlebar.addEventListener("pointermove", (e) => {
    if (!drag) return;
    dx = e.clientX - drag.startX;
    dy = e.clientY - drag.startY;
    applyOffset();
    clampToViewport();
  });
  const endDrag = () => { drag = null; };
  titlebar.addEventListener("pointerup", endDrag);
  titlebar.addEventListener("pointercancel", endDrag);
</script>